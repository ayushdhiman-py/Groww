# Upstox Analytics Token (long-lived, read-only). Generate one from the
# Upstox Developer Apps dashboard -> Analytics tab -> Generate Token.
# Never commit your real token — this file only holds a placeholder.
UPSTOX_ACCESS_TOKEN=your_upstox_analytics_token_here

NODE_ENV=development

# Basic Auth for the whole app. Required whenever this server is reachable
# from outside localhost (e.g. via a tunnel) — leave unset only for local-only dev.
DASHBOARD_USER=
DASHBOARD_PASS=
