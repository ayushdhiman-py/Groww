# Auto-detect text files and normalize line endings to LF in Git
* text=auto eol=lf

# Force .env files to always use LF (Unix line endings)
*.env text eol=lf

# Force shell scripts to use LF
*.sh text eol=lf

# Force JavaScript/TypeScript to use LF
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Force config files to use LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Force markdown to use LF
*.md text eol=lf

# Force CSS/HTML to use LF
*.css text eol=lf
*.html text eol=lf
